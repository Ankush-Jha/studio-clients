{
  "$description": "Studio tokens (W3C DTCG style). logo.light = file to place on light backgrounds; logo.dark = file to place on dark backgrounds. All colours provisional until the Desk writes kits/<slug>/confirm.json.",
  "color": {
    "accent": {
      "$type": "color",
      "$value": "#FAF8F5",
      "$extensions": {
        "studio": {
          "source": "website",
          "provisional": true,
          "contrastVsPaper": 1.0,
          "palette": [
            "#FAF8F5"
          ],
          "note": "website brand colours: https://www.greenbrix.ca/"
        }
      }
    },
    "ink": {
      "$type": "color",
      "$value": "#111111",
      "$extensions": {
        "studio": {
          "source": "default",
          "provisional": true
        }
      }
    },
    "paper": {
      "$type": "color",
      "$value": "#FAF8F5",
      "$extensions": {
        "studio": {
          "source": "website",
          "provisional": true
        }
      }
    }
  },
  "font": {
    "display": {
      "$type": "fontFamily",
      "$value": "Young Serif",
      "$extensions": {
        "studio": {
          "source": "assets/krystian-catala/greenbrix/BRIEF.md"
        }
      }
    },
    "body": {
      "$type": "fontFamily",
      "$value": "Instrument Sans",
      "$extensions": {
        "studio": {
          "source": "assets/krystian-catala/greenbrix/BRIEF.md",
          "note": "numbers and labels: Geist Mono"
        }
      }
    }
  },
  "logo": {
    "light": {
      "$type": "asset",
      "$value": "assets/krystian-catala/greenbrix/assets/logo-t.png"
    },
    "dark": {
      "$type": "asset",
      "$value": "assets/krystian-catala/greenbrix/assets/logo-light.png"
    }
  }
}
