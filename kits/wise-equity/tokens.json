{
  "$description": "Studio tokens (W3C DTCG style). logo.light = file to place on light backgrounds; logo.dark = file to place on dark backgrounds. All colours provisional until the Desk writes kits/<slug>/confirm.json.",
  "color": {
    "accent": {
      "$type": "color",
      "$value": "#0F2418",
      "$extensions": {
        "studio": {
          "source": "website",
          "provisional": true,
          "contrastVsPaper": 14.86,
          "palette": [
            "#0F2418",
            "#18552B",
            "#C9A227"
          ],
          "note": "website brand colours: https://wiseequity.ca/"
        }
      }
    },
    "accent2": {
      "$type": "color",
      "$value": "#C9A227",
      "$extensions": {
        "studio": {
          "source": "website",
          "provisional": true
        }
      }
    },
    "ink": {
      "$type": "color",
      "$value": "#0F2418",
      "$extensions": {
        "studio": {
          "source": "website",
          "provisional": true
        }
      }
    },
    "paper": {
      "$type": "color",
      "$value": "#F7F4EC",
      "$extensions": {
        "studio": {
          "source": "website",
          "provisional": true
        }
      }
    }
  },
  "font": {
    "display": {
      "$type": "fontFamily",
      "$value": "Inter",
      "$extensions": {
        "studio": {
          "source": "default",
          "websiteFonts": [
            "Playfair Display",
            "Montserrat"
          ]
        }
      }
    },
    "body": {
      "$type": "fontFamily",
      "$value": "Inter",
      "$extensions": {
        "studio": {
          "source": "default"
        }
      }
    }
  },
  "logo": {
    "light": {
      "$type": "asset",
      "$value": "assets/wise-equity/logo.png",
      "$extensions": {
        "studio": {
          "note": "single logo file; variant for the other background not supplied"
        }
      }
    },
    "dark": {
      "$type": "asset",
      "$value": "assets/wise-equity/logo.png",
      "$extensions": {
        "studio": {
          "note": "single logo file; variant for the other background not supplied"
        }
      }
    }
  }
}
