{
  "$description": "Studio tokens (W3C DTCG style). logo.light = file to place on light backgrounds; logo.dark = file to place on dark backgrounds. All colours provisional until the Desk writes kits/<slug>/confirm.json.",
  "color": {
    "accent": {
      "$type": "color",
      "$value": "#202F18",
      "$extensions": {
        "studio": {
          "source": "website",
          "provisional": true,
          "contrastVsPaper": 12.67,
          "palette": [
            "#202F18",
            "#2867B2"
          ],
          "note": "website brand colours: https://brilliantinvestor.ca/"
        }
      }
    },
    "accent2": {
      "$type": "color",
      "$value": "#2867B2",
      "$extensions": {
        "studio": {
          "source": "website",
          "provisional": true
        }
      }
    },
    "ink": {
      "$type": "color",
      "$value": "#202F18",
      "$extensions": {
        "studio": {
          "source": "website",
          "provisional": true
        }
      }
    },
    "paper": {
      "$type": "color",
      "$value": "#F5F2EA",
      "$extensions": {
        "studio": {
          "source": "default",
          "provisional": true
        }
      }
    }
  },
  "font": {
    "display": {
      "$type": "fontFamily",
      "$value": "Inter",
      "$extensions": {
        "studio": {
          "source": "default",
          "websiteFonts": [
            "Noto Sans",
            "Poppins",
            "Bitter",
            "Sanchez"
          ]
        }
      }
    },
    "body": {
      "$type": "fontFamily",
      "$value": "Inter",
      "$extensions": {
        "studio": {
          "source": "default"
        }
      }
    }
  },
  "logo": {
    "light": {
      "$type": "asset",
      "$value": "assets/robert-cheszes/logo.png",
      "$extensions": {
        "studio": {
          "note": "single logo file; variant for the other background not supplied"
        }
      }
    },
    "dark": {
      "$type": "asset",
      "$value": "assets/robert-cheszes/logo.png",
      "$extensions": {
        "studio": {
          "note": "single logo file; variant for the other background not supplied"
        }
      }
    }
  }
}
