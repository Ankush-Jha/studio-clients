{
  "$description": "Studio tokens (W3C DTCG style). logo.light = file to place on light backgrounds; logo.dark = file to place on dark backgrounds. All colours provisional until the Desk writes kits/<slug>/confirm.json.",
  "color": {
    "accent": {
      "$type": "color",
      "$value": "#053564",
      "$extensions": {
        "studio": {
          "source": "footer",
          "provisional": true,
          "contrastVsPaper": 11.94,
          "palette": [
            "#053564",
            "#4E6F91",
            "#836339"
          ]
        }
      }
    },
    "accent2": {
      "$type": "color",
      "$value": "#4E6F91",
      "$extensions": {
        "studio": {
          "source": "footer",
          "provisional": true
        }
      }
    },
    "ink": {
      "$type": "color",
      "$value": "#1A181F",
      "$extensions": {
        "studio": {
          "source": "footer",
          "provisional": true
        }
      }
    },
    "paper": {
      "$type": "color",
      "$value": "#FBFBFB",
      "$extensions": {
        "studio": {
          "source": "footer",
          "provisional": true
        }
      }
    }
  },
  "font": {
    "display": {
      "$type": "fontFamily",
      "$value": "Libre Franklin",
      "$extensions": {
        "studio": {
          "source": "roster style 'broadsheet' (STYLES.md)",
          "secondaryStyleFonts": [
            "Courier Prime",
            "IBM Plex Sans Condensed"
          ]
        }
      }
    },
    "body": {
      "$type": "fontFamily",
      "$value": "Newsreader",
      "$extensions": {
        "studio": {
          "source": "roster style 'broadsheet' (STYLES.md)",
          "note": "nameplate: UnifrakturMaguntia"
        }
      }
    }
  },
  "logo": {
    "light": {
      "$type": "asset",
      "$value": "assets/georges-madi/logo.png",
      "$extensions": {
        "studio": {
          "note": "single logo file; variant for the other background not supplied"
        }
      }
    },
    "dark": {
      "$type": "asset",
      "$value": "assets/georges-madi/logo.png",
      "$extensions": {
        "studio": {
          "note": "single logo file; variant for the other background not supplied"
        }
      }
    }
  }
}
