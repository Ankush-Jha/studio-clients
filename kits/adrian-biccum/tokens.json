{
  "$description": "Studio tokens (W3C DTCG style). logo.light = file to place on light backgrounds; logo.dark = file to place on dark backgrounds. All colours provisional until the Desk writes kits/<slug>/confirm.json.",
  "color": {
    "accent": {
      "$type": "color",
      "$value": "#13AFF0",
      "$extensions": {
        "studio": {
          "source": "website",
          "provisional": true,
          "contrastVsPaper": 2.23,
          "palette": [
            "#13AFF0",
            "#2270E1",
            "#37589B"
          ],
          "note": "website brand colours: https://yourmortgageminute.ca/"
        }
      }
    },
    "accent2": {
      "$type": "color",
      "$value": "#2270E1",
      "$extensions": {
        "studio": {
          "source": "website",
          "provisional": true
        }
      }
    },
    "ink": {
      "$type": "color",
      "$value": "#111111",
      "$extensions": {
        "studio": {
          "source": "default",
          "provisional": true
        }
      }
    },
    "paper": {
      "$type": "color",
      "$value": "#F5F2EA",
      "$extensions": {
        "studio": {
          "source": "default",
          "provisional": true
        }
      }
    }
  },
  "font": {
    "display": {
      "$type": "fontFamily",
      "$value": "Big Shoulders",
      "$extensions": {
        "studio": {
          "source": "roster style 'bold-type' (STYLES.md)",
          "websiteFonts": [
            "Inter"
          ],
          "secondaryStyleFonts": [
            "Bricolage Grotesque",
            "Space Mono"
          ]
        }
      }
    },
    "body": {
      "$type": "fontFamily",
      "$value": "Big Shoulders",
      "$extensions": {
        "studio": {
          "source": "roster style 'bold-type' (STYLES.md)"
        }
      }
    }
  },
  "logo": {
    "light": {
      "$type": "asset",
      "$value": "assets/adrian-biccum/logo.png",
      "$extensions": {
        "studio": {
          "note": "single logo file; variant for the other background not supplied"
        }
      }
    },
    "dark": {
      "$type": "asset",
      "$value": "assets/adrian-biccum/logo.png",
      "$extensions": {
        "studio": {
          "note": "single logo file; variant for the other background not supplied"
        }
      }
    }
  }
}
