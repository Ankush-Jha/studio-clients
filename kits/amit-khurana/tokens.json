{
  "$description": "Studio tokens (W3C DTCG style). logo.light = file to place on light backgrounds; logo.dark = file to place on dark backgrounds. All colours provisional until the Desk writes kits/<slug>/confirm.json.",
  "color": {
    "accent": {
      "$type": "color",
      "$value": "#003047",
      "$extensions": {
        "studio": {
          "source": "website",
          "provisional": true,
          "contrastVsPaper": 12.4,
          "palette": [
            "#003047",
            "#8F022A",
            "#5F9EA0"
          ],
          "note": "website brand colours: https://amitkhurana.ca/"
        }
      }
    },
    "accent2": {
      "$type": "color",
      "$value": "#8F022A",
      "$extensions": {
        "studio": {
          "source": "website",
          "provisional": true
        }
      }
    },
    "ink": {
      "$type": "color",
      "$value": "#003047",
      "$extensions": {
        "studio": {
          "source": "website",
          "provisional": true
        }
      }
    },
    "paper": {
      "$type": "color",
      "$value": "#F5F2EA",
      "$extensions": {
        "studio": {
          "source": "default",
          "provisional": true
        }
      }
    }
  },
  "font": {
    "display": {
      "$type": "fontFamily",
      "$value": "Bodoni Moda",
      "$extensions": {
        "studio": {
          "source": "roster style 'magazine' (STYLES.md)",
          "websiteFonts": [
            "Roboto",
            "Inter"
          ],
          "secondaryStyleFonts": [
            "Young Serif",
            "Rethink Sans"
          ]
        }
      }
    },
    "body": {
      "$type": "fontFamily",
      "$value": "Schibsted Grotesk",
      "$extensions": {
        "studio": {
          "source": "roster style 'magazine' (STYLES.md)"
        }
      }
    }
  },
  "logo": {
    "light": {
      "$type": "asset",
      "$value": "assets/amit-khurana/logo.png",
      "$extensions": {
        "studio": {
          "note": "single logo file; variant for the other background not supplied"
        }
      }
    },
    "dark": {
      "$type": "asset",
      "$value": "assets/amit-khurana/logo.png",
      "$extensions": {
        "studio": {
          "note": "single logo file; variant for the other background not supplied"
        }
      }
    }
  }
}
