{
  "$description": "Studio tokens (W3C DTCG style). logo.light = file to place on light backgrounds; logo.dark = file to place on dark backgrounds. All colours provisional until the Desk writes kits/<slug>/confirm.json.",
  "color": {
    "accent": {
      "$type": "color",
      "$value": "#27357C",
      "$extensions": {
        "studio": {
          "source": "website",
          "provisional": true,
          "contrastVsPaper": 9.97,
          "palette": [
            "#27357C",
            "#EFF2FF"
          ],
          "note": "website brand colours: https://huntformortgages.com/"
        }
      }
    },
    "ink": {
      "$type": "color",
      "$value": "#27357C",
      "$extensions": {
        "studio": {
          "source": "website",
          "provisional": true
        }
      }
    },
    "paper": {
      "$type": "color",
      "$value": "#EFF2FF",
      "$extensions": {
        "studio": {
          "source": "website",
          "provisional": true
        }
      }
    }
  },
  "font": {
    "display": {
      "$type": "fontFamily",
      "$value": "Inter",
      "$extensions": {
        "studio": {
          "source": "default",
          "websiteFonts": [
            "Roboto"
          ]
        }
      }
    },
    "body": {
      "$type": "fontFamily",
      "$value": "Inter",
      "$extensions": {
        "studio": {
          "source": "default"
        }
      }
    }
  },
  "logo": {
    "light": {
      "$type": "asset",
      "$value": "assets/raoul-hunt/logo.png"
    },
    "dark": {
      "$type": "asset",
      "$value": "assets/raoul-hunt/logo.png"
    }
  }
}
