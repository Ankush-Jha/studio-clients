{
  "$description": "Studio tokens (W3C DTCG style). logo.light = file to place on light backgrounds; logo.dark = file to place on dark backgrounds. All colours provisional until the Desk writes kits/<slug>/confirm.json.",
  "color": {
    "accent": {
      "$type": "color",
      "$value": "#CE3936",
      "$extensions": {
        "studio": {
          "source": "website",
          "provisional": true,
          "contrastVsPaper": 4.4,
          "palette": [
            "#CE3936",
            "#101010",
            "#415168"
          ],
          "note": "website brand colours: https://mortgagesbyrihani.ca/"
        }
      }
    },
    "accent2": {
      "$type": "color",
      "$value": "#415168",
      "$extensions": {
        "studio": {
          "source": "website",
          "provisional": true
        }
      }
    },
    "ink": {
      "$type": "color",
      "$value": "#101010",
      "$extensions": {
        "studio": {
          "source": "website",
          "provisional": true
        }
      }
    },
    "paper": {
      "$type": "color",
      "$value": "#F5F2EA",
      "$extensions": {
        "studio": {
          "source": "default",
          "provisional": true
        }
      }
    }
  },
  "font": {
    "display": {
      "$type": "fontFamily",
      "$value": "Martian Mono",
      "$extensions": {
        "studio": {
          "source": "roster style 'terminal' (STYLES.md)",
          "websiteFonts": [
            "Montserrat"
          ],
          "secondaryStyleFonts": [
            "Mona Sans",
            "Mona Sans"
          ]
        }
      }
    },
    "body": {
      "$type": "fontFamily",
      "$value": "Martian Mono",
      "$extensions": {
        "studio": {
          "source": "roster style 'terminal' (STYLES.md)"
        }
      }
    }
  },
  "logo": {
    "light": {
      "$type": "asset",
      "$value": "assets/sahil-rihani/logo.png",
      "$extensions": {
        "studio": {
          "note": "single logo file; variant for the other background not supplied"
        }
      }
    },
    "dark": {
      "$type": "asset",
      "$value": "assets/sahil-rihani/logo.png",
      "$extensions": {
        "studio": {
          "note": "single logo file; variant for the other background not supplied"
        }
      }
    }
  }
}
