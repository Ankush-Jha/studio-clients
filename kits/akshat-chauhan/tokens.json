{
  "$description": "Studio tokens (W3C DTCG style). logo.light = file to place on light backgrounds; logo.dark = file to place on dark backgrounds. All colours provisional until the Desk writes kits/<slug>/confirm.json.",
  "color": {
    "accent": {
      "$type": "color",
      "$value": "#083A4F",
      "$extensions": {
        "studio": {
          "source": "website",
          "provisional": true,
          "contrastVsPaper": 10.86,
          "palette": [
            "#083A4F",
            "#C9962E",
            "#E3C078"
          ],
          "note": "website brand colours: https://akshatchauhan.ca/"
        }
      }
    },
    "accent2": {
      "$type": "color",
      "$value": "#C9962E",
      "$extensions": {
        "studio": {
          "source": "website",
          "provisional": true
        }
      }
    },
    "ink": {
      "$type": "color",
      "$value": "#083A4F",
      "$extensions": {
        "studio": {
          "source": "website",
          "provisional": true
        }
      }
    },
    "paper": {
      "$type": "color",
      "$value": "#F5F2EA",
      "$extensions": {
        "studio": {
          "source": "default",
          "provisional": true
        }
      }
    }
  },
  "font": {
    "display": {
      "$type": "fontFamily",
      "$value": "Bodoni Moda",
      "$extensions": {
        "studio": {
          "source": "roster style 'magazine' (STYLES.md)",
          "websiteFonts": [
            "Fraunces (display serif)",
            "Figtree (body)"
          ],
          "secondaryStyleFonts": [
            "Familjen Grotesk",
            "Familjen Grotesk"
          ]
        }
      }
    },
    "body": {
      "$type": "fontFamily",
      "$value": "Schibsted Grotesk",
      "$extensions": {
        "studio": {
          "source": "roster style 'magazine' (STYLES.md)"
        }
      }
    }
  },
  "logo": {
    "light": {
      "$type": "asset",
      "$value": "assets/akshat-chauhan/logo.png",
      "$extensions": {
        "studio": {
          "note": "single logo file; variant for the other background not supplied"
        }
      }
    },
    "dark": {
      "$type": "asset",
      "$value": "assets/akshat-chauhan/logo.png",
      "$extensions": {
        "studio": {
          "note": "single logo file; variant for the other background not supplied"
        }
      }
    }
  }
}
