{
  "$description": "Studio tokens (W3C DTCG style). logo.light = file to place on light backgrounds; logo.dark = file to place on dark backgrounds. All colours provisional until the Desk writes kits/<slug>/confirm.json.",
  "color": {
    "accent": {
      "$type": "color",
      "$value": "#292560",
      "$extensions": {
        "studio": {
          "source": "website",
          "provisional": true,
          "contrastVsPaper": 12.29,
          "palette": [
            "#292560",
            "#958D78"
          ],
          "note": "website brand colours: https://mortgageconnection.ca/"
        }
      }
    },
    "ink": {
      "$type": "color",
      "$value": "#292560",
      "$extensions": {
        "studio": {
          "source": "website",
          "provisional": true
        }
      }
    },
    "paper": {
      "$type": "color",
      "$value": "#F5F2EA",
      "$extensions": {
        "studio": {
          "source": "default",
          "provisional": true
        }
      }
    }
  },
  "font": {
    "display": {
      "$type": "fontFamily",
      "$value": "Martian Mono",
      "$extensions": {
        "studio": {
          "source": "roster style 'terminal' (STYLES.md)",
          "websiteFonts": [
            "DM Sans",
            "Jost (keithanddustinmortgages.ca)",
            "Open Sans",
            "Poppins (mortgageconnection.ca)"
          ],
          "secondaryStyleFonts": [
            "Archivo",
            "Archivo"
          ]
        }
      }
    },
    "body": {
      "$type": "fontFamily",
      "$value": "Martian Mono",
      "$extensions": {
        "studio": {
          "source": "roster style 'terminal' (STYLES.md)"
        }
      }
    }
  },
  "logo": {
    "light": {
      "$type": "asset",
      "$value": "assets/keith-crossland-dustin-moss/logo.png",
      "$extensions": {
        "studio": {
          "note": "single logo file; variant for the other background not supplied"
        }
      }
    },
    "dark": {
      "$type": "asset",
      "$value": "assets/keith-crossland-dustin-moss/logo.png",
      "$extensions": {
        "studio": {
          "note": "single logo file; variant for the other background not supplied"
        }
      }
    }
  }
}
