{
  "$description": "Studio tokens (W3C DTCG style). logo.light = file to place on light backgrounds; logo.dark = file to place on dark backgrounds. All colours provisional until the Desk writes kits/<slug>/confirm.json.",
  "color": {
    "accent": {
      "$type": "color",
      "$value": "#041E2F",
      "$extensions": {
        "studio": {
          "source": "footer",
          "provisional": true,
          "contrastVsPaper": 15.51,
          "palette": [
            "#041E2F"
          ]
        }
      }
    },
    "ink": {
      "$type": "color",
      "$value": "#04111B",
      "$extensions": {
        "studio": {
          "source": "footer",
          "provisional": true
        }
      }
    },
    "paper": {
      "$type": "color",
      "$value": "#F4F4F5",
      "$extensions": {
        "studio": {
          "source": "footer",
          "provisional": true
        }
      }
    }
  },
  "font": {
    "display": {
      "$type": "fontFamily",
      "$value": "Mona Sans",
      "$extensions": {
        "studio": {
          "source": "roster style 'bento' (STYLES.md)",
          "secondaryStyleFonts": [
            "Archivo",
            "Archivo"
          ]
        }
      }
    },
    "body": {
      "$type": "fontFamily",
      "$value": "Mona Sans",
      "$extensions": {
        "studio": {
          "source": "roster style 'bento' (STYLES.md)"
        }
      }
    }
  },
  "logo": {
    "light": {
      "$type": "asset",
      "$value": "assets/keaton-thornton-jim-thornton/logo.png",
      "$extensions": {
        "studio": {
          "note": "single logo file; variant for the other background not supplied"
        }
      }
    },
    "dark": {
      "$type": "asset",
      "$value": "assets/keaton-thornton-jim-thornton/logo.png",
      "$extensions": {
        "studio": {
          "note": "single logo file; variant for the other background not supplied"
        }
      }
    }
  }
}
