{
  "$description": "Studio tokens (W3C DTCG style). logo.light = file to place on light backgrounds; logo.dark = file to place on dark backgrounds. All colours provisional until the Desk writes kits/<slug>/confirm.json.",
  "color": {
    "accent": {
      "$type": "color",
      "$value": "#13AFF0",
      "$extensions": {
        "studio": {
          "source": "website",
          "provisional": true,
          "contrastVsPaper": 2.23,
          "palette": [
            "#13AFF0",
            "#49525B",
            "#37589B"
          ],
          "note": "website brand colours: https://michaelmarini.com/"
        }
      }
    },
    "accent2": {
      "$type": "color",
      "$value": "#37589B",
      "$extensions": {
        "studio": {
          "source": "website",
          "provisional": true
        }
      }
    },
    "ink": {
      "$type": "color",
      "$value": "#111111",
      "$extensions": {
        "studio": {
          "source": "default",
          "provisional": true
        }
      }
    },
    "paper": {
      "$type": "color",
      "$value": "#F5F2EA",
      "$extensions": {
        "studio": {
          "source": "default",
          "provisional": true
        }
      }
    }
  },
  "font": {
    "display": {
      "$type": "fontFamily",
      "$value": "Archivo",
      "$extensions": {
        "studio": {
          "source": "roster style 'swiss' (STYLES.md)",
          "websiteFonts": [
            "Hanken Grotesk"
          ],
          "secondaryStyleFonts": [
            "Mona Sans",
            "Mona Sans"
          ]
        }
      }
    },
    "body": {
      "$type": "fontFamily",
      "$value": "Archivo",
      "$extensions": {
        "studio": {
          "source": "roster style 'swiss' (STYLES.md)"
        }
      }
    }
  },
  "logo": {
    "light": {
      "$type": "asset",
      "$value": null
    },
    "dark": {
      "$type": "asset",
      "$value": null
    }
  }
}
