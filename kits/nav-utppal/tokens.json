{
  "$description": "Studio tokens (W3C DTCG style). logo.light = file to place on light backgrounds; logo.dark = file to place on dark backgrounds. All colours provisional until the Desk writes kits/<slug>/confirm.json.",
  "color": {
    "accent": {
      "$type": "color",
      "$value": "#12342E",
      "$extensions": {
        "studio": {
          "source": "website",
          "provisional": true,
          "contrastVsPaper": 11.76,
          "palette": [
            "#12342E",
            "#F7EEE4",
            "#C9B594"
          ],
          "note": "website brand colours: https://www.fidesmortgages.ca/"
        }
      }
    },
    "accent2": {
      "$type": "color",
      "$value": "#C9B594",
      "$extensions": {
        "studio": {
          "source": "website",
          "provisional": true
        }
      }
    },
    "ink": {
      "$type": "color",
      "$value": "#12342E",
      "$extensions": {
        "studio": {
          "source": "website",
          "provisional": true
        }
      }
    },
    "paper": {
      "$type": "color",
      "$value": "#F7EEE4",
      "$extensions": {
        "studio": {
          "source": "website",
          "provisional": true
        }
      }
    }
  },
  "font": {
    "display": {
      "$type": "fontFamily",
      "$value": "Bricolage Grotesque",
      "$extensions": {
        "studio": {
          "source": "roster style 'riso' (STYLES.md)",
          "websiteFonts": [
            "Montserrat",
            "Proxima Nova",
            "Caslon GraComD"
          ],
          "secondaryStyleFonts": [
            "Red Hat Display",
            "Red Hat Mono"
          ]
        }
      }
    },
    "body": {
      "$type": "fontFamily",
      "$value": "Space Mono",
      "$extensions": {
        "studio": {
          "source": "roster style 'riso' (STYLES.md)"
        }
      }
    }
  },
  "logo": {
    "light": {
      "$type": "asset",
      "$value": "assets/nav-utppal/logo.png",
      "$extensions": {
        "studio": {
          "note": "single logo file; variant for the other background not supplied"
        }
      }
    },
    "dark": {
      "$type": "asset",
      "$value": "assets/nav-utppal/logo.png",
      "$extensions": {
        "studio": {
          "note": "single logo file; variant for the other background not supplied"
        }
      }
    }
  }
}
