{
  "$description": "Studio tokens (W3C DTCG style). logo.light = file to place on light backgrounds; logo.dark = file to place on dark backgrounds. All colours provisional until the Desk writes kits/<slug>/confirm.json.",
  "color": {
    "accent": {
      "$type": "color",
      "$value": "#0274BE",
      "$extensions": {
        "studio": {
          "source": "website",
          "provisional": true,
          "contrastVsPaper": 4.42,
          "palette": [
            "#0274BE",
            "#41B750",
            "#000000"
          ],
          "note": "website brand colours: https://bpmortgages.ca/"
        }
      }
    },
    "accent2": {
      "$type": "color",
      "$value": "#41B750",
      "$extensions": {
        "studio": {
          "source": "website",
          "provisional": true
        }
      }
    },
    "ink": {
      "$type": "color",
      "$value": "#000000",
      "$extensions": {
        "studio": {
          "source": "website",
          "provisional": true
        }
      }
    },
    "paper": {
      "$type": "color",
      "$value": "#F5F2EA",
      "$extensions": {
        "studio": {
          "source": "default",
          "provisional": true
        }
      }
    }
  },
  "font": {
    "display": {
      "$type": "fontFamily",
      "$value": "Courier Prime",
      "$extensions": {
        "studio": {
          "source": "roster style 'paper-trail' (STYLES.md)",
          "websiteFonts": [
            "Montserrat",
            "Plus Jakarta Sans",
            "Inter"
          ],
          "secondaryStyleFonts": [
            "Libre Franklin",
            "Newsreader"
          ]
        }
      }
    },
    "body": {
      "$type": "fontFamily",
      "$value": "IBM Plex Sans Condensed",
      "$extensions": {
        "studio": {
          "source": "roster style 'paper-trail' (STYLES.md)"
        }
      }
    }
  },
  "logo": {
    "light": {
      "$type": "asset",
      "$value": "assets/byran-peters/logo.png",
      "$extensions": {
        "studio": {
          "note": "single logo file; variant for the other background not supplied"
        }
      }
    },
    "dark": {
      "$type": "asset",
      "$value": "assets/byran-peters/logo.png",
      "$extensions": {
        "studio": {
          "note": "single logo file; variant for the other background not supplied"
        }
      }
    }
  }
}
