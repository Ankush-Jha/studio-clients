{
  "$description": "Studio tokens (W3C DTCG style). logo.light = file to place on light backgrounds; logo.dark = file to place on dark backgrounds. All colours provisional until the Desk writes kits/<slug>/confirm.json.",
  "color": {
    "accent": {
      "$type": "color",
      "$value": "#044484",
      "$extensions": {
        "studio": {
          "source": "footer",
          "provisional": true,
          "contrastVsPaper": 8.79,
          "palette": [
            "#044484",
            "#698BAC"
          ]
        }
      }
    },
    "accent2": {
      "$type": "color",
      "$value": "#698BAC",
      "$extensions": {
        "studio": {
          "source": "footer",
          "provisional": true
        }
      }
    },
    "ink": {
      "$type": "color",
      "$value": "#044484",
      "$extensions": {
        "studio": {
          "source": "footer",
          "provisional": true
        }
      }
    },
    "paper": {
      "$type": "color",
      "$value": "#FCF4D4",
      "$extensions": {
        "studio": {
          "source": "footer",
          "provisional": true
        }
      }
    }
  },
  "font": {
    "display": {
      "$type": "fontFamily",
      "$value": "Archivo",
      "$extensions": {
        "studio": {
          "source": "roster style 'swiss' (STYLES.md)",
          "websiteFonts": [
            "Arial"
          ],
          "secondaryStyleFonts": [
            "Mona Sans",
            "Mona Sans"
          ]
        }
      }
    },
    "body": {
      "$type": "fontFamily",
      "$value": "Archivo",
      "$extensions": {
        "studio": {
          "source": "roster style 'swiss' (STYLES.md)"
        }
      }
    }
  },
  "logo": {
    "light": {
      "$type": "asset",
      "$value": "assets/jim-decoste/logo.png",
      "$extensions": {
        "studio": {
          "note": "single logo file; variant for the other background not supplied"
        }
      }
    },
    "dark": {
      "$type": "asset",
      "$value": "assets/jim-decoste/logo.png",
      "$extensions": {
        "studio": {
          "note": "single logo file; variant for the other background not supplied"
        }
      }
    }
  }
}
