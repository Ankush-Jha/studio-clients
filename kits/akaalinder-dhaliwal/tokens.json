{
  "$description": "Studio tokens (W3C DTCG style). logo.light = file to place on light backgrounds; logo.dark = file to place on dark backgrounds. All colours provisional until the Desk writes kits/<slug>/confirm.json.",
  "color": {
    "accent": {
      "$type": "color",
      "$value": "#E3B665",
      "$extensions": {
        "studio": {
          "source": "website",
          "provisional": true,
          "contrastVsPaper": 1.68,
          "palette": [
            "#E3B665",
            "#131B26",
            "#13AFF0"
          ],
          "note": "website brand colours: https://akaalinderdhaliwal.com/"
        }
      }
    },
    "accent2": {
      "$type": "color",
      "$value": "#131B26",
      "$extensions": {
        "studio": {
          "source": "website",
          "provisional": true
        }
      }
    },
    "ink": {
      "$type": "color",
      "$value": "#131B26",
      "$extensions": {
        "studio": {
          "source": "website",
          "provisional": true
        }
      }
    },
    "paper": {
      "$type": "color",
      "$value": "#F5F2EA",
      "$extensions": {
        "studio": {
          "source": "default",
          "provisional": true
        }
      }
    }
  },
  "font": {
    "display": {
      "$type": "fontFamily",
      "$value": "Big Shoulders",
      "$extensions": {
        "studio": {
          "source": "roster style 'bold-type' (STYLES.md)",
          "websiteFonts": [
            "Lato",
            "Jost"
          ],
          "secondaryStyleFonts": [
            "Red Hat Display",
            "Red Hat Mono"
          ]
        }
      }
    },
    "body": {
      "$type": "fontFamily",
      "$value": "Big Shoulders",
      "$extensions": {
        "studio": {
          "source": "roster style 'bold-type' (STYLES.md)"
        }
      }
    }
  },
  "logo": {
    "light": {
      "$type": "asset",
      "$value": null
    },
    "dark": {
      "$type": "asset",
      "$value": null
    }
  }
}
