{
  "$description": "Studio tokens (W3C DTCG style). logo.light = file to place on light backgrounds; logo.dark = file to place on dark backgrounds. All colours provisional until the Desk writes kits/<slug>/confirm.json.",
  "color": {
    "accent": {
      "$type": "color",
      "$value": "#874FFD",
      "$extensions": {
        "studio": {
          "source": "website",
          "provisional": true,
          "contrastVsPaper": 4.11,
          "palette": [
            "#874FFD",
            "#121111"
          ],
          "note": "website brand colours: https://kwmortgageadvisory.ca/"
        }
      }
    },
    "accent2": {
      "$type": "color",
      "$value": "#121111",
      "$extensions": {
        "studio": {
          "source": "website",
          "provisional": true
        }
      }
    },
    "ink": {
      "$type": "color",
      "$value": "#121111",
      "$extensions": {
        "studio": {
          "source": "website",
          "provisional": true
        }
      }
    },
    "paper": {
      "$type": "color",
      "$value": "#F5F2EA",
      "$extensions": {
        "studio": {
          "source": "default",
          "provisional": true
        }
      }
    }
  },
  "font": {
    "display": {
      "$type": "fontFamily",
      "$value": "Young Serif",
      "$extensions": {
        "studio": {
          "source": "roster style 'cutout' (STYLES.md)",
          "websiteFonts": [
            "Hanken Grotesk"
          ],
          "secondaryStyleFonts": [
            "Bodoni Moda",
            "Schibsted Grotesk"
          ]
        }
      }
    },
    "body": {
      "$type": "fontFamily",
      "$value": "Rethink Sans",
      "$extensions": {
        "studio": {
          "source": "roster style 'cutout' (STYLES.md)"
        }
      }
    }
  },
  "logo": {
    "light": {
      "$type": "asset",
      "$value": "assets/karven-wu/logo.png"
    },
    "dark": {
      "$type": "asset",
      "$value": "assets/karven-wu/logo.png"
    }
  }
}
