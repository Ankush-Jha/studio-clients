{
  "$description": "Studio tokens (W3C DTCG style). logo.light = file to place on light backgrounds; logo.dark = file to place on dark backgrounds. All colours provisional until the Desk writes kits/<slug>/confirm.json.",
  "color": {
    "accent": {
      "$type": "color",
      "$value": "#1464C6",
      "$extensions": {
        "studio": {
          "source": "footer",
          "provisional": true,
          "contrastVsPaper": 5.52,
          "palette": [
            "#1464C6",
            "#0C488F",
            "#5A90C5"
          ]
        }
      }
    },
    "accent2": {
      "$type": "color",
      "$value": "#0C488F",
      "$extensions": {
        "studio": {
          "source": "footer",
          "provisional": true
        }
      }
    },
    "ink": {
      "$type": "color",
      "$value": "#0C488F",
      "$extensions": {
        "studio": {
          "source": "footer",
          "provisional": true
        }
      }
    },
    "paper": {
      "$type": "color",
      "$value": "#FAFBFA",
      "$extensions": {
        "studio": {
          "source": "footer",
          "provisional": true
        }
      }
    }
  },
  "font": {
    "display": {
      "$type": "fontFamily",
      "$value": "Familjen Grotesk",
      "$extensions": {
        "studio": {
          "source": "roster style 'annotated' (STYLES.md)",
          "websiteFonts": [
            "Raleway (template)"
          ],
          "secondaryStyleFonts": [
            "Bodoni Moda",
            "Schibsted Grotesk"
          ]
        }
      }
    },
    "body": {
      "$type": "fontFamily",
      "$value": "Familjen Grotesk",
      "$extensions": {
        "studio": {
          "source": "roster style 'annotated' (STYLES.md)",
          "note": "handwriting accent: Nanum Pen Script"
        }
      }
    }
  },
  "logo": {
    "light": {
      "$type": "asset",
      "$value": "assets/rahul-vinod/logo.png"
    },
    "dark": {
      "$type": "asset",
      "$value": "assets/rahul-vinod/logo.png"
    }
  }
}
