{
  "$description": "Studio tokens (W3C DTCG style). logo.light = file to place on light backgrounds; logo.dark = file to place on dark backgrounds. All colours provisional until the Desk writes kits/<slug>/confirm.json.",
  "color": {
    "accent": {
      "$type": "color",
      "$value": "#DEA74D",
      "$extensions": {
        "studio": {
          "source": "website",
          "provisional": true,
          "contrastVsPaper": 1.93,
          "palette": [
            "#DEA74D",
            "#13AFF0"
          ],
          "note": "website brand colours: https://alwaystruefinancial.com/"
        }
      }
    },
    "accent2": {
      "$type": "color",
      "$value": "#13AFF0",
      "$extensions": {
        "studio": {
          "source": "website",
          "provisional": true
        }
      }
    },
    "ink": {
      "$type": "color",
      "$value": "#111111",
      "$extensions": {
        "studio": {
          "source": "default",
          "provisional": true
        }
      }
    },
    "paper": {
      "$type": "color",
      "$value": "#F5F2EA",
      "$extensions": {
        "studio": {
          "source": "default",
          "provisional": true
        }
      }
    }
  },
  "font": {
    "display": {
      "$type": "fontFamily",
      "$value": "Inter",
      "$extensions": {
        "studio": {
          "source": "default",
          "websiteFonts": [
            "Montserrat"
          ]
        }
      }
    },
    "body": {
      "$type": "fontFamily",
      "$value": "Inter",
      "$extensions": {
        "studio": {
          "source": "default"
        }
      }
    }
  },
  "logo": {
    "light": {
      "$type": "asset",
      "$value": "assets/anil-lakhiya/logo.png",
      "$extensions": {
        "studio": {
          "note": "single logo file; variant for the other background not supplied"
        }
      }
    },
    "dark": {
      "$type": "asset",
      "$value": "assets/anil-lakhiya/logo.png",
      "$extensions": {
        "studio": {
          "note": "single logo file; variant for the other background not supplied"
        }
      }
    }
  }
}
