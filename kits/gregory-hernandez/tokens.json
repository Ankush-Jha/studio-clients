{
  "$description": "Studio tokens (W3C DTCG style). logo.light = file to place on light backgrounds; logo.dark = file to place on dark backgrounds. All colours provisional until the Desk writes kits/<slug>/confirm.json.",
  "color": {
    "accent": {
      "$type": "color",
      "$value": "#111634",
      "$extensions": {
        "studio": {
          "source": "website",
          "provisional": true,
          "contrastVsPaper": 15.8,
          "palette": [
            "#111634",
            "#D4B225",
            "#203297"
          ],
          "note": "website brand colours: https://gregoryhernandez.ca/"
        }
      }
    },
    "accent2": {
      "$type": "color",
      "$value": "#D4B225",
      "$extensions": {
        "studio": {
          "source": "website",
          "provisional": true
        }
      }
    },
    "ink": {
      "$type": "color",
      "$value": "#111634",
      "$extensions": {
        "studio": {
          "source": "website",
          "provisional": true
        }
      }
    },
    "paper": {
      "$type": "color",
      "$value": "#F5F2EA",
      "$extensions": {
        "studio": {
          "source": "default",
          "provisional": true
        }
      }
    }
  },
  "font": {
    "display": {
      "$type": "fontFamily",
      "$value": "Mona Sans",
      "$extensions": {
        "studio": {
          "source": "roster style 'bento' (STYLES.md)",
          "websiteFonts": [
            "Roboto",
            "Inter"
          ],
          "secondaryStyleFonts": [
            "Martian Mono",
            "Martian Mono"
          ]
        }
      }
    },
    "body": {
      "$type": "fontFamily",
      "$value": "Mona Sans",
      "$extensions": {
        "studio": {
          "source": "roster style 'bento' (STYLES.md)"
        }
      }
    }
  },
  "logo": {
    "light": {
      "$type": "asset",
      "$value": "assets/gregory-hernandez/logo.png",
      "$extensions": {
        "studio": {
          "note": "single logo file; variant for the other background not supplied"
        }
      }
    },
    "dark": {
      "$type": "asset",
      "$value": "assets/gregory-hernandez/logo.png",
      "$extensions": {
        "studio": {
          "note": "single logo file; variant for the other background not supplied"
        }
      }
    }
  }
}
