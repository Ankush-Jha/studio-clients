{
  "$description": "Studio tokens (W3C DTCG style). logo.light = file to place on light backgrounds; logo.dark = file to place on dark backgrounds. All colours provisional until the Desk writes kits/<slug>/confirm.json.",
  "color": {
    "accent": {
      "$type": "color",
      "$value": "#002E6E",
      "$extensions": {
        "studio": {
          "source": "website",
          "provisional": true,
          "contrastVsPaper": 11.62,
          "palette": [
            "#002E6E",
            "#13AFF0"
          ],
          "note": "website brand colours: https://danbalch.com"
        }
      }
    },
    "accent2": {
      "$type": "color",
      "$value": "#13AFF0",
      "$extensions": {
        "studio": {
          "source": "website",
          "provisional": true
        }
      }
    },
    "ink": {
      "$type": "color",
      "$value": "#002E6E",
      "$extensions": {
        "studio": {
          "source": "website",
          "provisional": true
        }
      }
    },
    "paper": {
      "$type": "color",
      "$value": "#F5F2EA",
      "$extensions": {
        "studio": {
          "source": "default",
          "provisional": true
        }
      }
    }
  },
  "font": {
    "display": {
      "$type": "fontFamily",
      "$value": "Libre Franklin",
      "$extensions": {
        "studio": {
          "source": "roster style 'broadsheet' (STYLES.md)",
          "websiteFonts": [
            "Poppins"
          ],
          "secondaryStyleFonts": [
            "Courier Prime",
            "IBM Plex Sans Condensed"
          ]
        }
      }
    },
    "body": {
      "$type": "fontFamily",
      "$value": "Newsreader",
      "$extensions": {
        "studio": {
          "source": "roster style 'broadsheet' (STYLES.md)",
          "note": "nameplate: UnifrakturMaguntia"
        }
      }
    }
  },
  "logo": {
    "light": {
      "$type": "asset",
      "$value": "assets/dan-balch/logo.png",
      "$extensions": {
        "studio": {
          "note": "single logo file; variant for the other background not supplied"
        }
      }
    },
    "dark": {
      "$type": "asset",
      "$value": "assets/dan-balch/logo.png",
      "$extensions": {
        "studio": {
          "note": "single logo file; variant for the other background not supplied"
        }
      }
    }
  }
}
