{
  "$description": "Studio tokens (W3C DTCG style). logo.light = file to place on light backgrounds; logo.dark = file to place on dark backgrounds. All colours provisional until the Desk writes kits/<slug>/confirm.json.",
  "color": {
    "accent": {
      "$type": "color",
      "$value": "#6A031D",
      "$extensions": {
        "studio": {
          "source": "website",
          "provisional": true,
          "contrastVsPaper": 10.47,
          "palette": [
            "#6A031D",
            "#920029",
            "#FFE7A3"
          ],
          "note": "website brand colours: https://cpmg.ca/"
        }
      }
    },
    "ink": {
      "$type": "color",
      "$value": "#3A0211",
      "$extensions": {
        "studio": {
          "source": "website",
          "provisional": true
        }
      }
    },
    "paper": {
      "$type": "color",
      "$value": "#FFE7A3",
      "$extensions": {
        "studio": {
          "source": "website",
          "provisional": true
        }
      }
    }
  },
  "font": {
    "display": {
      "$type": "fontFamily",
      "$value": "Inter",
      "$extensions": {
        "studio": {
          "source": "default",
          "websiteFonts": [
            "Montserrat"
          ]
        }
      }
    },
    "body": {
      "$type": "fontFamily",
      "$value": "Inter",
      "$extensions": {
        "studio": {
          "source": "default"
        }
      }
    }
  },
  "logo": {
    "light": {
      "$type": "asset",
      "$value": "assets/vittorio-oliverio/logo.png",
      "$extensions": {
        "studio": {
          "note": "single logo file; variant for the other background not supplied"
        }
      }
    },
    "dark": {
      "$type": "asset",
      "$value": "assets/vittorio-oliverio/logo.png",
      "$extensions": {
        "studio": {
          "note": "single logo file; variant for the other background not supplied"
        }
      }
    }
  }
}
