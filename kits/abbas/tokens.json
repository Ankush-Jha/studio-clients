{
  "$description": "Studio tokens (W3C DTCG style). logo.light = file to place on light backgrounds; logo.dark = file to place on dark backgrounds. All colours provisional until the Desk writes kits/<slug>/confirm.json.",
  "color": {
    "accent": {
      "$type": "color",
      "$value": "#1E40AF",
      "$extensions": {
        "studio": {
          "source": "tokens",
          "provisional": true,
          "contrastVsPaper": 7.8
        }
      }
    },
    "ink": {
      "$type": "color",
      "$value": "#111111",
      "$extensions": {
        "studio": {
          "source": "default",
          "provisional": true
        }
      }
    },
    "paper": {
      "$type": "color",
      "$value": "#F5F2EA",
      "$extensions": {
        "studio": {
          "source": "default",
          "provisional": true
        }
      }
    }
  },
  "font": {
    "display": {
      "$type": "fontFamily",
      "$value": "Red Hat Display",
      "$extensions": {
        "studio": {
          "source": "roster style 'isometric' (STYLES.md)",
          "secondaryStyleFonts": [
            "Bricolage Grotesque",
            "Space Mono"
          ]
        }
      }
    },
    "body": {
      "$type": "fontFamily",
      "$value": "Red Hat Mono",
      "$extensions": {
        "studio": {
          "source": "roster style 'isometric' (STYLES.md)"
        }
      }
    }
  },
  "logo": {
    "light": {
      "$type": "asset",
      "$value": null
    },
    "dark": {
      "$type": "asset",
      "$value": null
    }
  }
}
