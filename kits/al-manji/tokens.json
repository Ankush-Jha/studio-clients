{
  "$description": "Studio tokens (W3C DTCG style). logo.light = file to place on light backgrounds; logo.dark = file to place on dark backgrounds. All colours provisional until the Desk writes kits/<slug>/confirm.json.",
  "color": {
    "accent": {
      "$type": "color",
      "$value": "#887833",
      "$extensions": {
        "studio": {
          "source": "website",
          "provisional": true,
          "contrastVsPaper": 3.93,
          "palette": [
            "#887833",
            "#333333"
          ],
          "note": "website brand colours: https://6ix.ca/team-member/al-manji/"
        }
      }
    },
    "ink": {
      "$type": "color",
      "$value": "#333333",
      "$extensions": {
        "studio": {
          "source": "website",
          "provisional": true
        }
      }
    },
    "paper": {
      "$type": "color",
      "$value": "#F5F2EA",
      "$extensions": {
        "studio": {
          "source": "default",
          "provisional": true
        }
      }
    }
  },
  "font": {
    "display": {
      "$type": "fontFamily",
      "$value": "Familjen Grotesk",
      "$extensions": {
        "studio": {
          "source": "roster style 'annotated' (STYLES.md)",
          "websiteFonts": [
            "Raleway"
          ],
          "secondaryStyleFonts": [
            "Young Serif",
            "Rethink Sans"
          ]
        }
      }
    },
    "body": {
      "$type": "fontFamily",
      "$value": "Familjen Grotesk",
      "$extensions": {
        "studio": {
          "source": "roster style 'annotated' (STYLES.md)",
          "note": "handwriting accent: Nanum Pen Script"
        }
      }
    }
  },
  "logo": {
    "light": {
      "$type": "asset",
      "$value": "assets/al-manji/logo.png"
    },
    "dark": {
      "$type": "asset",
      "$value": "assets/al-manji/logo.png"
    }
  }
}
