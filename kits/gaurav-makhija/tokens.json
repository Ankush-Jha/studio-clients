{
  "$description": "Studio tokens (W3C DTCG style). logo.light = file to place on light backgrounds; logo.dark = file to place on dark backgrounds. All colours provisional until the Desk writes kits/<slug>/confirm.json.",
  "color": {
    "accent": {
      "$type": "color",
      "$value": "#C28300",
      "$extensions": {
        "studio": {
          "source": "website",
          "provisional": true,
          "contrastVsPaper": 2.87,
          "palette": [
            "#C28300",
            "#13AFF0"
          ],
          "note": "website brand colours: https://edanmortgages.com"
        }
      }
    },
    "accent2": {
      "$type": "color",
      "$value": "#13AFF0",
      "$extensions": {
        "studio": {
          "source": "website",
          "provisional": true
        }
      }
    },
    "ink": {
      "$type": "color",
      "$value": "#111111",
      "$extensions": {
        "studio": {
          "source": "default",
          "provisional": true
        }
      }
    },
    "paper": {
      "$type": "color",
      "$value": "#F5F2EA",
      "$extensions": {
        "studio": {
          "source": "default",
          "provisional": true
        }
      }
    }
  },
  "font": {
    "display": {
      "$type": "fontFamily",
      "$value": "Courier Prime",
      "$extensions": {
        "studio": {
          "source": "roster style 'paper-trail' (STYLES.md)",
          "websiteFonts": [
            "DM Sans",
            "Libre Caslon Text"
          ],
          "secondaryStyleFonts": [
            "Libre Franklin",
            "Newsreader"
          ]
        }
      }
    },
    "body": {
      "$type": "fontFamily",
      "$value": "IBM Plex Sans Condensed",
      "$extensions": {
        "studio": {
          "source": "roster style 'paper-trail' (STYLES.md)"
        }
      }
    }
  },
  "logo": {
    "light": {
      "$type": "asset",
      "$value": "assets/gaurav-makhija/logo.png",
      "$extensions": {
        "studio": {
          "note": "single logo file; variant for the other background not supplied"
        }
      }
    },
    "dark": {
      "$type": "asset",
      "$value": "assets/gaurav-makhija/logo.png",
      "$extensions": {
        "studio": {
          "note": "single logo file; variant for the other background not supplied"
        }
      }
    }
  }
}
