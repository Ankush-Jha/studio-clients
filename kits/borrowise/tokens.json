{
  "$description": "Studio tokens (W3C DTCG style). logo.light = file to place on light backgrounds; logo.dark = file to place on dark backgrounds. All colours provisional until the Desk writes kits/<slug>/confirm.json.",
  "color": {
    "accent": {
      "$type": "color",
      "$value": "#D9534F",
      "$extensions": {
        "studio": {
          "source": "website",
          "provisional": true,
          "contrastVsPaper": 3.76,
          "palette": [
            "#F9F9F8",
            "#D9534F",
            "#CC3366"
          ],
          "note": "website brand colours: https://borrowise.ca/"
        }
      }
    },
    "ink": {
      "$type": "color",
      "$value": "#111111",
      "$extensions": {
        "studio": {
          "source": "default",
          "provisional": true
        }
      }
    },
    "paper": {
      "$type": "color",
      "$value": "#F9F9F8",
      "$extensions": {
        "studio": {
          "source": "website",
          "provisional": true
        }
      }
    }
  },
  "font": {
    "display": {
      "$type": "fontFamily",
      "$value": "Young Serif",
      "$extensions": {
        "studio": {
          "source": "roster style 'cutout' (STYLES.md)",
          "websiteFonts": [
            "Gilroy",
            "Mont"
          ],
          "secondaryStyleFonts": [
            "Bodoni Moda",
            "Schibsted Grotesk"
          ]
        }
      }
    },
    "body": {
      "$type": "fontFamily",
      "$value": "Rethink Sans",
      "$extensions": {
        "studio": {
          "source": "roster style 'cutout' (STYLES.md)"
        }
      }
    }
  },
  "logo": {
    "light": {
      "$type": "asset",
      "$value": "assets/borrowise/logo.png",
      "$extensions": {
        "studio": {
          "note": "single logo file; variant for the other background not supplied"
        }
      }
    },
    "dark": {
      "$type": "asset",
      "$value": "assets/borrowise/logo.png",
      "$extensions": {
        "studio": {
          "note": "single logo file; variant for the other background not supplied"
        }
      }
    }
  }
}
