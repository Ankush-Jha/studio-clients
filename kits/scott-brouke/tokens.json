{
  "$description": "Studio tokens (W3C DTCG style). logo.light = file to place on light backgrounds; logo.dark = file to place on dark backgrounds. All colours provisional until the Desk writes kits/<slug>/confirm.json.",
  "color": {
    "accent": {
      "$type": "color",
      "$value": "#005CB9",
      "$extensions": {
        "studio": {
          "source": "website",
          "provisional": true,
          "contrastVsPaper": 5.75,
          "palette": [
            "#005CB9",
            "#13AFF0",
            "#F1F1F1"
          ],
          "note": "website brand colours: https://yourbestmortgage.ca/"
        }
      }
    },
    "accent2": {
      "$type": "color",
      "$value": "#13AFF0",
      "$extensions": {
        "studio": {
          "source": "website",
          "provisional": true
        }
      }
    },
    "ink": {
      "$type": "color",
      "$value": "#111111",
      "$extensions": {
        "studio": {
          "source": "default",
          "provisional": true
        }
      }
    },
    "paper": {
      "$type": "color",
      "$value": "#F1F1F1",
      "$extensions": {
        "studio": {
          "source": "website",
          "provisional": true
        }
      }
    }
  },
  "font": {
    "display": {
      "$type": "fontFamily",
      "$value": "Archivo",
      "$extensions": {
        "studio": {
          "source": "roster style 'swiss' (STYLES.md)",
          "websiteFonts": [
            "Inter"
          ],
          "secondaryStyleFonts": [
            "Martian Mono",
            "Martian Mono"
          ]
        }
      }
    },
    "body": {
      "$type": "fontFamily",
      "$value": "Archivo",
      "$extensions": {
        "studio": {
          "source": "roster style 'swiss' (STYLES.md)"
        }
      }
    }
  },
  "logo": {
    "light": {
      "$type": "asset",
      "$value": "assets/scott-brouke/logo.png",
      "$extensions": {
        "studio": {
          "note": "single logo file; variant for the other background not supplied"
        }
      }
    },
    "dark": {
      "$type": "asset",
      "$value": "assets/scott-brouke/logo.png",
      "$extensions": {
        "studio": {
          "note": "single logo file; variant for the other background not supplied"
        }
      }
    }
  }
}
