{
  "$description": "Studio tokens (W3C DTCG style). logo.light = file to place on light backgrounds; logo.dark = file to place on dark backgrounds. All colours provisional until the Desk writes kits/<slug>/confirm.json.",
  "color": {
    "accent": {
      "$type": "color",
      "$value": "#004282",
      "$extensions": {
        "studio": {
          "source": "website",
          "provisional": true,
          "contrastVsPaper": 8.93,
          "palette": [
            "#004282",
            "#13AFF0"
          ],
          "note": "website brand colours: https://arianaleroux.com/"
        }
      }
    },
    "accent2": {
      "$type": "color",
      "$value": "#13AFF0",
      "$extensions": {
        "studio": {
          "source": "website",
          "provisional": true
        }
      }
    },
    "ink": {
      "$type": "color",
      "$value": "#004282",
      "$extensions": {
        "studio": {
          "source": "website",
          "provisional": true
        }
      }
    },
    "paper": {
      "$type": "color",
      "$value": "#F5F2EA",
      "$extensions": {
        "studio": {
          "source": "default",
          "provisional": true
        }
      }
    }
  },
  "font": {
    "display": {
      "$type": "fontFamily",
      "$value": "Young Serif",
      "$extensions": {
        "studio": {
          "source": "roster style 'cutout' (STYLES.md)",
          "websiteFonts": [
            "Montserrat"
          ],
          "secondaryStyleFonts": [
            "Familjen Grotesk",
            "Familjen Grotesk"
          ]
        }
      }
    },
    "body": {
      "$type": "fontFamily",
      "$value": "Rethink Sans",
      "$extensions": {
        "studio": {
          "source": "roster style 'cutout' (STYLES.md)"
        }
      }
    }
  },
  "logo": {
    "light": {
      "$type": "asset",
      "$value": "assets/ariana-learoux/logo.png",
      "$extensions": {
        "studio": {
          "note": "single logo file; variant for the other background not supplied"
        }
      }
    },
    "dark": {
      "$type": "asset",
      "$value": "assets/ariana-learoux/logo.png",
      "$extensions": {
        "studio": {
          "note": "single logo file; variant for the other background not supplied"
        }
      }
    }
  }
}
